{
  "name": "muiltchat",
  "version": "0.1.0",
  "description": "Cross-session context query and conversation system for AI coding assistants",
  "type": "commonjs",
  "bin": {
    "muiltchat": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/index.ts mcp",
    "serve": "tsx src/index.ts serve",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "ai",
    "context",
    "cross-session",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@muiltchat/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
