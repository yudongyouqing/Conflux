{
  "name": "conflux",
  "version": "0.1.0",
  "description": "Cross-session context query and conversation system for AI coding assistants",
  "type": "commonjs",
  "bin": {
    "conflux": "dist/index.js",
    "muiltchat": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/index.ts mcp",
    "serve": "tsx src/index.ts serve",
    "test": "node --import tsx --test \"src/test/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "ai",
    "context",
    "cross-session",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/openai": "^4.0.92",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@conflux/shared": "*",
    "ai": "^7.0.138",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "fastify": "^5.12.5",
    "pino": "^9.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
