{
  "name": "conflux",
  "version": "0.3.1",
  "description": "Cross-session context query and conversation system for AI coding assistants",
  "type": "commonjs",
  "bin": {
    "conflux": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/index.ts mcp",
    "serve": "tsx src/index.ts serve",
    "test": "node --import tsx --test \"src/test/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "test:process-e2e": "node --import tsx --test \"src/test/*.e2e.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "ai",
    "context",
    "cross-session",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/openai": "^4.0.111",
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@conflux/shared": "*",
    "ai": "^7.0.166",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.3",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
